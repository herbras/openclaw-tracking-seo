# Microsoft Clarity API Configuration
# Copy file ini ke .env dan isi dengan API token kamu

# Clarity API Token - dapatkan dari: Settings → Data Export → Generate new API Token
CLARITY_API_TOKEN=your_api_token_here

# Project ID Clarity kamu (dapat dari dashboard Clarity)
CLARITY_PROJECT_ID=your_project_id_here

# Nama project untuk report
PROJECT_NAME=My Website

# Email untuk notifikasi (opsional)
NOTIFICATION_EMAIL=

# Output folder untuk report
OUTPUT_DIR=./reports

# Bing Webmaster Tools Configuration
# Dapatkan API key dari: Bing Webmaster Tools > Settings > API Access
BING_WEBMASTER_API_KEY=your_bing_api_key_here
